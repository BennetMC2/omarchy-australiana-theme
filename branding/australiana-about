#!/bin/bash
set -euo pipefail
python3 - "$@" <<'PY'
import os
import shutil
import sys
from pathlib import Path

config = Path(os.environ.get('AUSTRALIANA_CONFIG_ROOT', str(Path.home() / '.config')))
state = Path(os.environ.get('AUSTRALIANA_STATE_ROOT', str(Path.home() / '.local/state'))) / 'australiana/branding'
target = config / 'omarchy/branding/about.txt'
source = config / 'omarchy/themes/australiana/branding/kangaroo.txt'
marker = state / 'active'
backup = state / 'previous-about.txt'

def exists(path):
    return path.exists() or path.is_symlink()

def remove(path):
    if exists(path):
        path.unlink()

if len(sys.argv) > 1 and sys.argv[1] == 'australiana':
    art = source.read_text()
    state.mkdir(parents=True, exist_ok=True)
    target.parent.mkdir(parents=True, exist_ok=True)
    if not marker.exists():
        remove(backup)
        if exists(target):
            shutil.copy2(target, backup, follow_symlinks=False)
        marker.write_text('active\n')
    # Explicit ANSI gold works with an existing Fastfetch logo colour setting.
    gold = ''.join('\033[33m' + line + '\033[0m\n' for line in art.splitlines())
    temporary = target.with_name('about.txt.australiana-next')
    temporary.write_text(gold)
    temporary.replace(target)
elif marker.exists():
    remove(target)
    if exists(backup):
        shutil.copy2(backup, target, follow_symlinks=False)
    marker.unlink()
PY
